<!-- Custom Wazuh Local Ruleset - Detection Engineering & Threat Hunting Lab -->
<!-- Reference: https://documentation.wazuh.com/current/user-manual/ruleset/ruleset-xml-syntax/rules.html -->

<group name="custom,powershell,attack,schtasks,registry,evasion,credential_access,">

  <!-- ====================================================================== -->
  <!-- RULE 100100: T1059.001 - Parent Correlation / Severity Escalation     -->
  <!-- Description: Parent correlation rule that inherits from Wazuh default  -->
  <!-- rule 92057 (PowerShell execution), elevating severity to Level 15 and  -->
  <!-- enriching the alert with MITRE ATT&CK taxonomy metadata.               -->
  <!-- ====================================================================== -->
  <rule id="100100" level="15">
    <if_sid>92057</if_sid>
    <description>Custom Detection: Base64 Encoded PowerShell Execution - Parent Correlation (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>attack,powershell,custom_detection,parent_correlation,</group>
  </rule>

  <!-- ====================================================================== -->
  <!-- RULE 100105: T1059.001 - Standalone Direct Sysmon Field Match          -->
  <!-- Description: Standalone detection rule inspecting Sysmon Event ID 1     -->
  <!-- process creation telemetry for powershell.exe with encoded flags.     -->
  <!-- ====================================================================== -->
  <rule id="100105" level="15">
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">1</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\powershell\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\s+-e\s+|\s+-encodedcommand\s+|\s+-enc\s+)</field>
    <description>Custom Detection: Base64 Encoded PowerShell Command Line Execution - Standalone Rule (T1059.001)</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>attack,powershell,custom_detection,standalone,</group>
  </rule>

  <!-- ====================================================================== -->
  <!-- RULE 100101: T1053.005 - Scheduled Task Creation                       -->
  <!-- Description: Standalone rule matching Sysmon Event ID 1 process       -->
  <!-- creation for schtasks.exe with the /create parameter.                 -->
  <!-- ====================================================================== -->
  <rule id="100101" level="12">
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">1</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\/create</field>
    <description>Custom Detection: Scheduled Task Creation via schtasks.exe (T1053.005)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>attack,persistence,custom_detection,standalone,</group>
  </rule>

  <!-- ====================================================================== -->
  <!-- RULE 100102: T1547.001 - Parent Correlation / Severity Escalation     -->
  <!-- Description: Parent correlation rule inheriting from default rule 92302-->
  <!-- (Registry entry autostart modification), elevating severity to Level 12-->
  <!-- and tagging with MITRE T1547.001.                                      -->
  <!-- ====================================================================== -->
  <rule id="100102" level="12">
    <if_sid>92302</if_sid>
    <description>Custom Detection: Registry Run Key Persistence Modification - Parent Correlation (T1547.001)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>attack,persistence,custom_detection,parent_correlation,</group>
  </rule>

  <!-- ====================================================================== -->
  <!-- RULE 100103: T1070.001 - Windows Event Log Cleared                     -->
  <!-- Description: Standalone rule matching Sysmon Event ID 1 process       -->
  <!-- creation for wevtutil.exe with log clearing switches (cl / clear).    -->
  <!-- ====================================================================== -->
  <rule id="100103" level="13">
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">1</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\wevtutil\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\s+cl\s+|\s+clear\s+)</field>
    <description>Custom Detection: Windows Event Log Cleared via wevtutil.exe (T1070.001)</description>
    <mitre>
      <id>T1070.001</id>
    </mitre>
    <group>attack,defense_evasion,custom_detection,standalone,</group>
  </rule>

  <!-- ====================================================================== -->
  <!-- RULE 100104: T1555.004 - Windows Credential Store Enumeration          -->
  <!-- Description: Standalone rule matching Sysmon Event ID 1 process       -->
  <!-- creation for cmdkey.exe with the /list parameter.                     -->
  <!-- ====================================================================== -->
  <rule id="100104" level="14">
    <field name="win.system.providerName">Microsoft-Windows-Sysmon</field>
    <field name="win.system.eventID">1</field>
    <field name="win.eventdata.image" type="pcre2">(?i)\\cmdkey\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)\/list</field>
    <description>Custom Detection: Saved Credentials Enumeration via cmdkey.exe (T1555.004)</description>
    <mitre>
      <id>T1555.004</id>
    </mitre>
    <group>attack,credential_access,custom_detection,standalone,</group>
  </rule>

</group>
